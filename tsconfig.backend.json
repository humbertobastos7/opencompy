{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": [
		"src/backend/**/*.ts",
		"src/ai/**/*.ts",
		"src/env/backend.ts",
		"src/env/ai.ts",
		"src/shared/nest/**/*.ts",
		"src/shared/**/*.ts"
	],
	"exclude": ["src/frontend"]
}
