# =============================================================================
# Compy — local environment
# Copy this file to .env and paste your API keys. There is no login: the app
# creates a single local user on first run, so no auth secrets are needed.
# =============================================================================

# -----------------------------------------------------------------------------
# Core services (defaults match `docker compose up db`)
# -----------------------------------------------------------------------------

DATABASE_URL=postgres://admin:password@localhost:5432/compy_db
AI_SERVICE_URL=http://localhost:3001
VITE_USE_REALTIME_CHAT=true

# -----------------------------------------------------------------------------
# LLM — Anthropic (required for the conversation)
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=<paste-your-anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-4-6
# Cheaper model used only for the post-conversation summary.
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5-20251001
# Web search during the conversation: disabled | auto | always
LLM_WEB_SEARCH=auto

# -----------------------------------------------------------------------------
# Voice — ElevenLabs (required for speech-to-text and text-to-speech)
# The default voice is a development placeholder; replace it with one that
# speaks European Portuguese.
# -----------------------------------------------------------------------------

ELEVENLABS_API_KEY=<paste-your-elevenlabs-api-key>
ELEVENLABS_VOICE_ID_DEFAULT=rlcdD8CF7T3X802nl2MF
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.75

# -----------------------------------------------------------------------------
# Memory — OpenAI embeddings (optional)
# Used only to remember facts between conversations. Without it Compy still
# talks, but does not recall facts from earlier conversations.
# -----------------------------------------------------------------------------

OPENAI_API_KEY=<paste-your-openai-api-key>
