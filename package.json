{
	"name": "compy.ai",
	"version": "1.0.0",
	"module": "src/backend/main.ts",
	"type": "module",
	"scripts": {
		"dev": "dotenv -e .env -- concurrently -n frontend,backend,ai -c blue,green,magenta \"pnpm run dev:frontend\" \"pnpm run dev:backend\" \"pnpm run dev:ai\"",
		"dev:frontend": "vite --host",
		"dev:backend": "dotenv -e .env -- cross-env PORT=3000 node --import tsx --watch src/backend/main.ts",
		"dev:ai": "dotenv -e .env -- cross-env PORT=3001 node --import tsx --watch src/ai/main.ts",
		"dev:nowatch": "dotenv -e .env -- concurrently -n frontend,backend,ai -c blue,green,magenta \"vite --host\" \"cross-env PORT=3000 node --import tsx src/backend/main.ts\" \"cross-env PORT=3001 node --import tsx src/ai/main.ts\"",
		"build": "vite build && pnpm run build:server",
		"build:frontend": "vite build",
		"build:backend": "pnpm run build:server",
		"build:ai": "pnpm run build:server",
		"build:server": "tsc --noEmit -p tsconfig.backend.json && node scripts/build-server.mjs",
		"start": "dotenv -e .env -- cross-env PORT=3000 node --import tsx src/backend/main.ts",
		"start:backend": "dotenv -e .env -- cross-env PORT=3000 node --import tsx src/backend/main.ts",
		"start:ai": "dotenv -e .env -- cross-env PORT=3001 node --import tsx src/ai/main.ts",
		"start:backend:prod": "dotenv -e .env -- cross-env PORT=3000 node dist/backend/main.js",
		"start:ai:prod": "dotenv -e .env -- cross-env PORT=3001 node dist/ai/main.js",
		"start:server": "pnpm run start",
		"build:mobile": "dotenv -e .env -- vite build && cap sync",
		"db:studio": "dotenv -e .env -- drizzle-kit studio",
		"db:migrate": "dotenv -e .env -- drizzle-kit migrate",
		"db:gen": "dotenv -e .env -- drizzle-kit generate",
		"db:reset": "docker compose down -v && docker compose up --build migrate",
		"format": "biome format --write .",
		"tscheck": "tsc --noEmit",
		"test": "vitest run",
		"seed:load-test": "dotenv -e .env -- tsx scripts/seed-load-test.ts"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.0.1",
		"@eslint/js": "^9.19.0",
		"@tanstack/router-devtools": "1.97.25",
		"@tanstack/router-generator": "1.97.25",
		"@tanstack/router-plugin": "1.97.25",
		"@tanstack/virtual-file-routes": "1.97.8",
		"@types/node": "24.0.0",
		"@types/pg": "^8.11.11",
		"@types/react": "19.0.8",
		"@types/react-dom": "19.0.3",
		"@types/ws": "^8.18.1",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.2",
		"cross-env": "^10.1.0",
		"daisyui": "^4.12.23",
		"esbuild": "^0.27.3",
		"eslint": "^9.19.0",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-refresh": "^0.4.18",
		"globals": "^15.14.0",
		"postcss": "^8.5.1",
		"tailwindcss": "^3.4.17",
		"tsx": "^4.20.3",
		"typescript": "5.7.3",
		"typescript-eslint": "^8.22.0",
		"vite": "6.0.11",
		"vite-plugin-pwa": "0.21.1"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@nestjs/core",
			"argon2",
			"esbuild",
			"protobufjs",
			"sharp"
		]
	},
