		"dom-to-image": "^2.6.0",
		"dotenv-cli": "^8.0.0",
		"drizzle-kit": "^0.30.3",
		"drizzle-orm": "^0.39.0",
		"echarts": "^5.6.0",
		"fastify": "^5.6.1",
